*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Build outputs (this project)
/verse
/catalogtool

# Dear ImGui runtime layout file
imgui.ini

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Release packaging output
dist/

# Runtime cache written by the in-app "Import real data" feature
assets/universes/_imported.json

# User-local runtime settings (written by the app on exit / "Save now")
settings.json

# Source audio/video exports; runtime uses compressed assets such as .ogg
assets/*.mov

# AI assistant worktrees
.claude/worktrees/
.codex/worktrees/

# Full catalog downloads (regenerate via tools/build_known_universe.py / catalogtool)
assets/catalogs/*_full.csv
# Compact binary star catalogs referenced by a preset's "star_catalog" field
# (regenerate via: catalogtool gaia-bin <gaia.csv> assets/catalogs/<name>.bin)
assets/catalogs/*.bin
# ...but the Known Universe's body_catalog IS committed: it holds the bulk
# interactive bodies (nearby stars + exoplanet systems) that used to live inline
# in known_universe.json, and there is no full-catalog CSV in the repo to rebuild
# it from a fresh checkout.
!assets/catalogs/known_universe_bodies.bin
tools/_known_tmp/

# Python bytecode cache
__pycache__/
*.pyc

CLAUDE.md
docs/*.txt
docs/PERF_HANDOFF.md
assets/PS_2026.07.03_09.35.26.csv
