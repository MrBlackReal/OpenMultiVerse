*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Release packaging output
dist/

# Runtime cache written by the in-app "Import real data" feature
assets/universes/_imported.json

# User-local runtime settings (written by the app on exit / "Save now")
settings.json

# Source audio/video exports; runtime uses compressed assets such as .ogg
assets/*.mov

# Catalog CSVs: the large ones are downloaded/generated by
# tools/fetch_catalogs.py and stay local. Everything that CANNOT be regenerated
# ships: the curated black holes (no bulk feed exists), the small samples that
# build_known_universe.py falls back to on a fresh checkout, and the
# hand-made test catalogs. (assets/bright_star_catalog.csv, loaded by the sim,
# sits outside this pattern and ships too.)
assets/*/*.csv
!assets/catalogs/black_holes.csv
!assets/catalogs/exoplanets_sample.csv
!assets/catalogs/gaia_sample.csv
!assets/catalogs/horizons_sample.csv
!assets/catalogs/trappist1.csv

# AI assistant worktrees
.claude/worktrees/
.codex/worktrees/
tools/_known_tmp/

# Python bytecode cache
__pycache__/
*.pyc

CLAUDE.md
docs/*.txt
docs/PERF_HANDOFF.md
assets/PS_2026.07.03_09.35.26.csv

# CI step scratch output (see .github/workflows/ci.yml)
build.log
orphans.txt

# Build intermediates (make): build/<flavour>/...
/build/

# Raw 3D dust map source (tools/fetch_dustmap.py); the baked dust_local.bin ships
assets/catalogs/*.fits

# Local 4K master; the compressed showcase.mp4 is what ships
showcase_4k.mp4

# Scratch preview from tools/fetch_dustmap.py --preview
dust.pgm

# Raw SDSS BOSS/eBOSS LSS catalogs (tools/fetch_boss.py bakes them)
assets/catalogs/sdss/*.fits
assets/catalogs/sdss/*.fits.gz

# Baked GPU texture caches (src/render/texpack.c regenerates them)
*.bc7.dds
